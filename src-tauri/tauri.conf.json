{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RapidReady",
  "version": "0.1.0",
  "identifier": "com.ole.rapid-ready",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RapidReady",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: rr-image: asset: data: blob:; img-src 'self' tauri: rr-image: asset: data: blob:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
